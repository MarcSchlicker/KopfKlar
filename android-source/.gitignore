# dependencies
/node_modules
/.npm-cache/
/android-build-*.log
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Android build artifacts
/android/.gradle/
/android/app/build/
/android/local.properties
/android-web/dist/
/KopfKlar*.apk
/KopfKlar*.apk.idsig
/KopfKlar*.aab
# Lokaler Android-Upload-Schlüssel und Zugangsdaten – niemals veröffentlichen.
/android/kopfklar-upload.jks
/android/keystore.properties
/.codex/
